# ============================================================================
# Forleads — Environment configuration
# Copy to `.env.local` and fill in. Local development runs in mock mode with
# zero credentials. In production, omitted switches infer safe live defaults:
# Nominatim geocoding, OSM property facts, Supabase when configured, Mapillary
# when configured, and Claude when configured. Set a switch explicitly to
# override that inference.
# Production mock connector writes are disabled by default. The escape hatch
# below is for disposable previews only and must never be set on the main
# production deployment.
# Secrets are SERVER-ONLY. Never expose anything but NEXT_PUBLIC_* to the client.
# ============================================================================

# ---- Provider mode switches -------------------------------------------------
# These explicit values preserve mock-first local development.
FORLEADS_AGENT_MODE=mock              # Claude reasoning: mock | live
FORLEADS_PROPERTY_PROVIDER=osm-mock   # osm-mock | osm | open-data | (per-market)
FORLEADS_IMAGERY_PROVIDER=mock        # mock | mapillary
FORLEADS_GEOCODER=mock                # mock | nominatim | photon-nominatim
FORLEADS_PERSIST=memory               # memory (in-process) | supabase
FORLEADS_ALLOW_PRODUCTION_MOCKS=0
# Only set for a deliberately single-tenant deployment. Multi-tenant runtime
# never falls back to global CRM credentials.
FORLEADS_SINGLE_TENANT=0

# ---- Claude (Agent brain) ---------------------------------------------------
# Used by Dispatcher / Notes classifier / Composer / Compliance / Reducer.
ANTHROPIC_API_KEY=
FORLEADS_CLAUDE_MODEL=claude-sonnet-4-6

# ---- Vision + bulk (cheap classification / photo understanding) -------------
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Supabase / Postgres (persistence, auth, RLS, pgvector) -----------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY — never ship to client
DATABASE_URL=

# ---- Open/free property intelligence ----------------------------------------
# These are public/open-data or self-hosted ETL inputs. Without a configured
# open source for a market, Forleads returns honest grade-D gaps instead of
# inventing owner, occupancy, ARV, distress, or hazard facts.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_SALES_DATA_URL=
OPEN_SALES_DATA_URLS=
HMLR_PRICE_PAID_URL=
COUNTY_OPEN_DATA_URL=
US_OPEN_SALES_DATA_URL=
UK_PRICE_PAID_DATA_URL=
ENGLAND_PRICE_PAID_DATA_URL=
EU_OPEN_SALES_DATA_URL=
EU_CADASTRE_DATA_URL=
AFRICA_OPEN_SALES_DATA_URL=
OPERATOR_SALES_IMPORT_URL=
OPEN_DISTRESS_DATA_URL=
OPEN_DISTRESS_DATA_URLS=
TAX_DELINQUENCY_DATA_URL=
CODE_VIOLATION_DATA_URL=
VACANT_REGISTRY_DATA_URL=
US_DISTRESS_DATA_URL=
UK_DISTRESS_DATA_URL=
EU_DISTRESS_DATA_URL=
AFRICA_DISTRESS_DATA_URL=
FEMA_NFHL_URL=
OPEN_HAZARD_LAYER_URL=
US_HAZARD_LAYER_URL=
UK_HAZARD_LAYER_URL=
EU_HAZARD_LAYER_URL=
AFRICA_HAZARD_LAYER_URL=
MICROSOFT_BUILDING_FOOTPRINTS_URL=
GOOGLE_OPEN_BUILDINGS_URL=
LOCAL_BUILDINGS_GEOJSON_URL=
AFRICA_BUILDINGS_DATA_URL=
# Planned only: these URLs are not consumed by the current runtime adapters.
# Do not set them expecting a live capability badge.
OPEN_ADDRESSES_URL=
CENSUS_TIGER_LINE_URL=

# ---- Field scout / free automation bridges ----------------------------------
FIELD_PHOTO_STORAGE=
NEXT_PUBLIC_ENABLE_ROUTE_TRACKING=0
# Planned only. ZAPIER_WEBHOOK_URL below is the implemented outbound bridge.
N8N_WEBHOOK_URL=

# ---- Geocoding (self-hosted) ------------------------------------------------
PHOTON_URL=http://localhost:2322
NOMINATIM_URL=http://localhost:8080

# ---- Imagery ----------------------------------------------------------------
MAPILLARY_TOKEN=
ESRI_ATTRIBUTION="Imagery © Esri"

# ---- Embeddings (lead-scoped memory recall) ---------------------------------
# Server-only. When OLLAMA_URL is unreachable or unset, a deterministic hash
# embedder is used so the loop still runs (mock-first principle). The selected
# model must emit 1024-dim vectors to match the memories.embedding column.
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024

# ============================================================================
# CONNECTORS — credentials are necessary but not sufficient. Google and the
# approval-gated Zapier outbound bridge are the currently supported setup-now
# paths. Microsoft, CRM, SMS, inbound Zapier, and paid property sources stay
# blocked until the adapter-specific gates in docs/operator-setup-guide.md pass.
# ============================================================================

# ---- Google Workspace (Gmail drafts + Calendar) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI in your Google OAuth client.
# Local:  http://localhost:3000/api/auth/google/callback
# Vercel: https://forleads.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Minimal scopes: compose drafts only + calendar events.
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/calendar.events

# ---- Microsoft 365 (Outlook + Calendar) -------------------------------------
# BLOCKED: refresh-token persistence must ship before user onboarding.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ---- Follow Up Boss (CRM) ---------------------------------------------------
FOLLOWUPBOSS_BASE_URL=https://api.followupboss.com/v1
# Required by FUB for systems serving customer accounts. Register Forleads and
# deploy the issued values before the Connector Hub enables FUB onboarding.
FOLLOWUPBOSS_SYSTEM_NAME=
FOLLOWUPBOSS_SYSTEM_KEY=

# ---- GoHighLevel (CRM / agencies) -------------------------------------------
# BLOCKED: contact-id-bound note/task writes are not complete.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_BASE_URL=https://services.leadconnectorhq.com

# ---- Twilio (SMS — approved sends only) -------------------------------------
# BLOCKED: consent, STOP/DNC, quiet-hours, A2P, and delivery gates are absent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Zapier / generic webhooks ----------------------------------------------
# Outbound works after approval. Inbound remains blocked for multi-tenant use.
ZAPIER_WEBHOOK_SECRET=
ZAPIER_WEBHOOK_URL=

# ---- Auth / session --------------------------------------------------------
# Encrypts the login session cookie (which carries the user's Google tokens).
# Generate one: `openssl rand -hex 32`. REQUIRED in production.
SESSION_SECRET=
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Optional: a Google access token for server-to-server testing without OAuth.
GOOGLE_ACCESS_TOKEN=

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
FORLEADS_DEMO_AGENT_ID=00000000-0000-0000-0000-000000000001
